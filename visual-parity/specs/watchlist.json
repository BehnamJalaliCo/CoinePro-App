  "cadence": [
    {
      "id": "row-cadence",
      "tags": [
        "watchlist-row-0",
        "watchlist-row-1",
        "watchlist-row-2",
        "watchlist-row-3",
        "watchlist-row-4"
      ],
      "reference_count": 5,
      "budget_px": 1,
      "note": "Five consecutive rows, every gap measured against the first. Neighbour-to-neighbour averages away the half-pixel that accumulates: five rows down that is two and a half pixels, and by row forty it is a slope somebody can see."
    }
  ],
