{
  "schema": 2,
  "screen": "watchlist",
  "title": "The watchlist",
  "locale": "en-US",
  "why": "It is the app's root destination and the screen a reader opens by reflex. Its fold decides how many markets they see before scrolling, and its row cadence is what makes a long list readable or exhausting.",
  "reference": {
    "dark": "watchlist-dark.png",
    "light": "watchlist-light.png"
  },
  "actual": {
    "dark": "watchlist-dark.png",
    "light": "watchlist-light.png"
  },
  "mask_budget": {
    "development": 0.15,
    "certification": 0.05
  },
  "masks": [
    {
      "class": "price",
      "reason": "Content. Their BTC and ours were quoted seconds apart and neither number says anything about layout. The price cell's box stays compared.",
      "elements": [
        "watchlist-row-*-price"
      ],
      "halo_px": 2
    },
    {
      "class": "percent-change",
      "reason": "Content, and additionally a declared light-theme colour deviation.",
      "elements": [
        "watchlist-row-*-percent"
      ],
      "halo_px": 2
    },
    {
      "class": "sparkline",
      "reason": "Content: a drawing of the last few hours, which differ.",
      "elements": [
        "watchlist-row-*-spark"
      ],
      "halo_px": 2
    },
    {
      "class": "symbol-artwork",
      "reason": "Symbol marks are licensed per exchange and are not the same set on both sides. Only the interior is covered — the logo's bounding box, its distance to the ticker and the row's padding all stay measured.",
      "elements": [
        "watchlist-row-*-logo"
      ],
      "halo_px": 3
    },
    {
      "class": "brand-mark",
      "reason": "Their wordmark and ours are the two things that are supposed to differ.",
      "elements": [
        "watchlist-wordmark"
      ],
      "halo_px": 2
    }
  ],
