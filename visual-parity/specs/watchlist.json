  "known_differences": [
    {
      "label": "INTENTIONAL_ACCESSIBILITY_DEVIATION",
      "what": "Light theme marketUp #057A66 and marketDown #D01427 against their #089981 and #F23645.",
      "why": "Theirs measure below 4.5:1 on our light surface. Ours are 4.62:1 and 5.02:1. Dark theme uses their values unchanged. Accessibility is not traded for a score."
    },
    {
      "label": "INTENTIONAL_BRAND_DIFFERENCE",
      "what": "The header carries our own wordmark and its stream animation.",
      "why": "It is the one piece of this screen that is deliberately ours."
    },
    {
      "label": "DYNAMIC_CONTENT",
      "what": "Every price, percentage, sparkline and symbol mark.",
      "why": "Masked at the interior only."
    }
  ]
