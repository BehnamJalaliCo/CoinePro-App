<?xml version="1.0" encoding="utf-8"?>
<!--
    LBank's mark, as it is now.

    The first version of this file was their **old** blue circular mark, taken from a logo archive
    that had not been updated. The archives are what a search finds; they are not what a company is
    using. This one is measured from the icon the owner supplied, which is the current identity: a
    black squircle, a yellow field inside it pinched at the right, and the black bone through the
    middle that makes the whole thing read as a B.

    Measured rather than traced. The silhouette was scanned row by row, the two lobes of the bone
    solved as circles from three rows each — centres (103, 52.8) and (103.5, 168.25), both radius
    26 — and the two colours sampled from the file: `#FFD900` and `#161616`, not a guess at either.

    The artwork is trimmed to its own bounds, so it sits at the same visual weight beside Ourbit's
    mark on the membership card. The source icon carries about a tenth of padding; keeping it would
    have made LBank's button look like the quieter of the two.

    Never tinted. It is somebody else's mark and both colours are part of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="222"
    android:viewportHeight="220">

    <!-- The black squircle. -->
    <path
        android:fillColor="#161616"
        android:pathData="M54,0 L167,0 A54,54 0 0 1 221,54 L221,165 A54,54 0 0 1 167,219
                          L54,219 A54,54 0 0 1 0,165 L0,54 A54,54 0 0 1 54,0 Z" />

    <!--
        The yellow field. Its right edge is the whole character of the mark: it bulges out at
        roughly a third and two thirds of the height and pinches back to x=175 between them, which
        is what turns a rounded square into a B.
    -->
    <path
        android:fillColor="#FFD900"
        android:pathData="M53,10 L145,10 C172,10 191,34 191,69 C191,92 175,95 175,111
                          C175,127 194,130 194,151 C194,185 178,210 145,210 L53,210
                          C20,210 9,199 9,166 L9,54 C9,21 20,10 53,10 Z" />

    <!--
        The bone: two circles and the waist between them, as three subpaths of one path.

        Three rather than one traced outline, and the same fill colour, so the overlaps simply
        union under non-zero winding. Solving the tangents by hand would have been a longer way to
        the same pixels with more places to be slightly wrong.
    -->
    <path
        android:fillColor="#161616"
        android:pathData="M77,52.8 A26,26 0 1 0 129,52.8 A26,26 0 1 0 77,52.8 Z
                          M77.5,168.25 A26,26 0 1 0 129.5,168.25 A26,26 0 1 0 77.5,168.25 Z
                          M121.4,66 C121.4,88 109,95 109,111 C109,127 121.4,134 121.4,155
                          L85.6,155 C85.6,134 98,127 98,111 C98,95 85.6,88 85.6,66 Z" />
</vector>
