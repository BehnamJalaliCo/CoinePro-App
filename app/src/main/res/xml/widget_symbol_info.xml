<?xml version="1.0" encoding="utf-8"?>
<!--
  The single-symbol tile — run Τ2, B7.

  Two cells by one is the size it is designed at: a ticker, a price large enough to read across a
  room, and the change under it. `minResizeHeight` allows one cell, where `SymbolWidgetPick` drops
  the change and the freshness and leaves the price alone — a price tile without a price is a
  decoration, and everything else gives way to it.

  `updatePeriodMillis` is 0 for `widget_markets_info`'s reason: `WidgetRefreshWorker` already
  refreshes both widgets on one schedule, and a second one would be a second wake-up for the same
  prices.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_symbol"
    android:previewLayout="@layout/widget_symbol"
    android:description="@string/widget_symbol_description"
    android:minWidth="140dp"
    android:minHeight="70dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="70dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.coinepro.app.widget.SymbolWidgetConfigureActivity"
    android:updatePeriodMillis="0" />
