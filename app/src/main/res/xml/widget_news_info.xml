<?xml version="1.0" encoding="utf-8"?>
<!--
  The news widget (5.27.0). Four cells by two, as TradingView's is; refreshed by the same worker as
  the price widgets, so a reader with all three pays for one schedule. `configure` is the settings
  screen — which feed — and is reopened by the gear in the header.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_news"
    android:previewLayout="@layout/widget_news_preview"
    android:description="@string/widget_news_description"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="300dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.coinepro.app.widget.NewsWidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:updatePeriodMillis="0" />
