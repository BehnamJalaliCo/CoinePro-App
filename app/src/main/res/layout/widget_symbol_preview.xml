<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher's picker draws for the one-market tile (5.27.0): the real layout with a
     sample market in it. Without one the picker drew the empty layout — a blank white card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,UseAppTint"
    android:id="@+id/preview_symbol_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/preview_symbol_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_symbol_ticker"
        android:text="BTCUSDT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="ltr"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/preview_symbol_name"
        android:text="@string/widget_preview_btc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/preview_symbol_logo"
            android:src="@drawable/asset_btc"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Not `Space`: a `RemoteViews` tree may hold only the views the launcher agrees to inflate. -->
    <FrameLayout
        android:id="@+id/preview_symbol_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/preview_symbol_price"
        android:text="62,450.10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="26sp"
        android:textDirection="ltr"
        android:textColor="@color/widget_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_symbol_change"
        android:text="+1,432.50  +2.35%"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textDirection="ltr"
                android:textColor="@color/widget_buy" />

            <TextView
                android:id="@+id/preview_symbol_freshness"
        android:text="@string/widget_preview_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/preview_symbol_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:src="@drawable/icon_arrows_clockwise"
            android:tint="@color/widget_text_secondary"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Shown alone when the snapshot does not carry this market. See `SymbolWidgetPick`. -->
    <TextView
        android:id="@+id/preview_symbol_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="@color/widget_text_secondary" />
</LinearLayout>
