<?xml version="1.0" encoding="utf-8"?>
<!--
  The news widget (5.27.0), TradingView's third: one headline at a time with its time, its source and
  its picture, arrows to page through the rest, «more» into the app, refresh and settings (which
  feed: crypto, or forex and gold).

  One story rather than a list, as theirs is: a headline needs two or three lines to be a sentence,
  and at four by two a list of them is a list of fragments.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/news_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="1dp"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:id="@+id/news_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_header_background"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher_round"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/news_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_primary"
                android:text="@string/widget_news_crypto" />

            <TextView
                android:id="@+id/news_freshness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/news_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/icon_arrows_clockwise"
            android:tint="@color/widget_text_primary"
            android:contentDescription="@string/widget_refresh" />

        <ImageView
            android:id="@+id/news_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/icon_gear_six"
            android:tint="@color/widget_text_primary"
            android:contentDescription="@string/widget_settings" />
    </LinearLayout>

    <!-- The skeleton until the first snapshot; the renderer hides it (5.28.0). -->
    <include
        android:id="@+id/news_skeleton"
        layout="@layout/widget_skeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/news_story"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/news_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/news_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/news_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/news_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:textSize="12sp"
        android:visibility="gone"
        android:textColor="@color/widget_text_secondary" />

    <LinearLayout
        android:id="@+id/news_footer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/news_more"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/widget_pill"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:text="@string/widget_news_more" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/news_previous"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/icon_caret_left"
            android:tint="@color/widget_text_primary"
            android:contentDescription="@string/widget_news_previous" />

        <TextView
            android:id="@+id/news_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="32dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/widget_text_muted" />

        <ImageView
            android:id="@+id/news_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/icon_caret_right"
            android:tint="@color/widget_text_primary"
            android:contentDescription="@string/widget_news_next" />
    </LinearLayout>
</LinearLayout>
