<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CoinePro" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!--
      The window the launcher shows before Compose has drawn a frame. White, like the launch sheet
      `LaunchSplash` draws over the app, so the first frame the reader sees and the first frame
      Compose draws are the same colour — a black window under a white sheet flashes once, which
      is the one thing a launch must not do. `MainActivity` switches back to `Theme.CoinePro`
      before `super.onCreate`.
    -->
    <style name="Theme.CoinePro.Launch">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
</resources>
