<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's plate: a rounded rectangle with a hairline.

  The same shape language as the app's cards — a hairline and a radius, no shadow and no gradient,
  which is the surface discipline `scripts/quality/check-motion-policy.sh` enforces on every other
  surface in the product. A widget that looked glassier than the app it opens would be the first
  thing a reader sees and the first thing that looks wrong.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_stage" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="20dp" />
</shape>
