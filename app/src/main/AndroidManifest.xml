<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".CoineProApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoinePro"
        android:usesCleartextTraffic="false">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!--
          Sharing a chart image. `exported=false` with `grantUriPermissions` is the pair that makes
          this safe: no other app can query the provider, and the one app the reader chose gets a
          one-shot grant for the single file named in the intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CoinePro.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Hosts are named one by one on purpose. A bare scheme claims every coinepro:// URI
                in existence, which is more than the app can act on, and Android does not verify
                ownership of a custom scheme at all — any other installed app may register the
                same one. These two are what CoineProFirebaseMessagingService actually emits, and
                nothing that carries a credential is ever routed this way.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coinepro" android:host="signal" />
                <data android:scheme="coinepro" android:host="activity" />
                <!--
                    The home-screen widget's rows. A ticker is not a credential and not a private
                    fact — it is the name of a market — so the custom scheme is the right carrier
                    here in a way it would not be for a token.
                -->
                <data android:scheme="coinepro" android:host="market" />
            </intent-filter>

            <!--
                Password recovery arrives as an https link rather than a coinepro:// one, because
                it carries a reset token. An App Link is verified by the system against
                /.well-known/assetlinks.json on the host, so no other app can intercept it; a
                custom scheme offers no such guarantee.

                The host is TradeYar's user-facing web app, where sign-in and registration already
                live and where the reset page joins them. It is named exactly rather than as a
                wildcard: verification is performed per host, and a pattern host is not verified.

                Only /reset is claimed. The rest of that site — sign-in, registration — stays with
                the browser, where someone who is not carrying the app can still use it.

                Until the Play signing certificate exists the fingerprint in assetlinks.json cannot
                be the real one, so verification fails and the link opens in the browser. That is
                harmless and has to work anyway, for anyone who opens the email on a desktop.
                Correcting the fingerprint later turns the same link into an in-app one with no
                change here and no change to the email already sent.

                CoinePro-FX's own host joins this list once it is known.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="user.tradeyar.trade-future.ir"
                    android:pathPrefix="/reset" />
                <!--
                    CoinePro-FX's own recovery link, on its API host. The path differs from
                    TradeYar's because the two web apps spell it differently; both are named
                    exactly, because verification is per host and a pattern host is not verified.

                    Note that the app's *own* recovery flow is not a link at all — it mails a code
                    that the reader types back. This filter is for somebody who opens the web
                    e-mail on a phone that happens to have the app.
                -->
                <data
                    android:scheme="https"
                    android:host="coineprofx.com"
                    android:pathPrefix="/reset-password" />
            </intent-filter>
        </activity>

        <!--
            The markets widget.

            `exported="true"` is required and is not a choice: the system's own AppWidget host
            sends the broadcasts, and a provider it cannot reach is a widget that never updates.
            The receiver acts only on `APPWIDGET_UPDATE` and on its own refresh action, and neither
            carries anything an untrusted caller could use — the worst a hostile broadcast achieves
            is a price refresh.
        -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.CoinePro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MarketsWidget"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.coinepro.app.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_markets_info" />
        </receiver>

        <service
            android:name=".notifications.CoineProFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
