    <!-- the export -->
    <string name="admin_export_title">Export</string>
    <string name="admin_export_body">A text file with the build, the handset, the state at the moment of export, the failing requests, the last crash, and the log exactly as you have filtered it. What a developer actually needs to fix something.</string>
    <string name="admin_export_share">Share the file</string>
