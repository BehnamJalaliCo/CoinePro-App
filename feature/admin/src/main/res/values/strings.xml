<resources>

    <!-- the door -->
    <string name="admin_lock_title">Admin panel</string>
    <string name="admin_lock_body">This screen does not only report; it acts. It signs both platforms out, restarts the market feed, drops caches and exports a file describing this install. That is why it asks for a username and a password.</string>
    <string name="admin_lock_username">Username</string>
    <string name="admin_lock_password">Password</string>
    <string name="admin_lock_enter">Sign in</string>
    <string name="admin_lock_refused">That username and password do not match.</string>
    <string name="admin_lock_locked">Closed after five failed attempts. Try again in %1$s minutes.</string>
    <string name="admin_lock_unprovisioned">This build has no key for this door. Until a credential is configured at build time the panel will not open — which is the correct behaviour for a door.</string>
    <string name="admin_lock_now">Lock the panel</string>

