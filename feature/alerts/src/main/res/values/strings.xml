    <string name="alerts_audit_title">کارنامهٔ هشدار</string>
    <string name="alerts_audit_lead">این سیاههٔ کاری است که این هشدار واقعاً انجام داده. اگر حرکتی را از دست داده‌اید، اینجا معلوم می‌شود اعلان رسیده یا نرسیده.</string>
