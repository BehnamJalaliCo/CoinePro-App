<resources>
    <string name="tool_risk_title">Risk calculator</string>
    <string name="tool_risk_eyebrow">Risk control</string>
    <string name="tool_risk_body">Turn an account risk percentage into a fixed monetary risk budget.</string>
    <string name="tool_risk_formula">Risk amount = capital × risk %</string>
    <string name="tool_position_title">Position size / lot</string>
    <string name="tool_position_eyebrow">Sizing</string>
    <string name="tool_position_body">Size a position from monetary risk, stop distance and pip value per standard lot.</string>
    <string name="tool_position_formula">Lots = risk amount ÷ (stop pips × pip value per lot)</string>
    <string name="tool_rr_title">Risk to reward</string>
    <string name="tool_rr_eyebrow">Trade layout</string>
    <string name="tool_rr_body">Checks that entry, stop and target sit in the right order before comparing reward with risk.</string>
    <string name="tool_rr_formula">Ratio = |target − entry| ÷ |entry − stop|</string>
    <string name="tool_drawdown_title">Drawdown simulator</string>
    <string name="tool_drawdown_eyebrow">Capital resilience</string>
    <string name="tool_drawdown_body">Model compounded consecutive losses and the return needed to recover.</string>
    <string name="tool_drawdown_formula">Ending balance = start × (1 − loss %) ^ losses</string>
    <string name="tool_profit_title">Profit calculator</string>
    <string name="tool_profit_eyebrow">Forex and metals</string>
    <string name="tool_profit_body">Estimate directional P&amp;L from price movement, lots and contract size.</string>
    <string name="tool_profit_formula">P&amp;L = signed price move × lots × contract size</string>
    <string name="tool_pip_title">Pip calculator</string>
    <string name="tool_pip_eyebrow">Price distance</string>
    <string name="tool_pip_body">Translate a price move into signed pips and P&amp;L with explicit pip assumptions.</string>
    <string name="tool_pip_formula">Pips = signed price move ÷ pip size</string>
    <string name="tool_crypto_title">Crypto P&amp;L</string>
    <string name="tool_crypto_eyebrow">USDT pairs</string>
    <string name="tool_crypto_body">Estimate spot-style directional P&amp;L after entry and exit fees.</string>
    <string name="tool_crypto_formula">Net = gross − entry fee − exit fee</string>
    <string name="tool_compound_title">Compound calculator</string>
    <string name="tool_compound_eyebrow">Growth</string>
    <string name="tool_compound_body">Model period-by-period compounding without projecting future market returns.</string>
    <string name="tool_compound_formula">Ending = principal × (1 + rate %) ^ periods</string>
